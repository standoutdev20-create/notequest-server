PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/notequest
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d
# Browser origins allowed to call the API directly (site + CRM)
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001
# In production, e.g. .notequest.in so the login cookie is shared with the site
COOKIE_DOMAIN=
